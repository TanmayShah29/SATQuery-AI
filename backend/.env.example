# SatQuery AI - Environment Configuration & API Keys
# Copy this file to .env: cp backend/.env.example backend/.env

# ==============================================================================
# 1. LIVE SATQUERY SETTINGS (Defaults work out-of-the-box with NO KEYS)
# ==============================================================================
APP_ENV=development
PORT=8080
HOST=0.0.0.0

# ==============================================================================
# 2. SATELLITE CLOUD APIS (Currently 100% Free & Keyless)
# ==============================================================================
# AWS Open Data Element84 STAC (Sentinel-2 L2A) - NO KEY REQUIRED
STAC_ELEMENT84_URL=https://earth-search.aws.element84.com/v1/search

# Microsoft Planetary Computer (Sentinel-1 SAR) - NO KEY REQUIRED
STAC_PLANETARY_URL=https://planetarycomputer.microsoft.com/api/stac/v1/search
PLANETARY_SAS_URL=https://planetarycomputer.microsoft.com/api/sas/v1/sign

# ==============================================================================
# 3. OPTIONAL MANUAL CREDENTIALS (For advanced fine-tuning or cloud LLMs)
# ==============================================================================
# Hugging Face Access Token (Free at https://huggingface.co/settings/tokens)
# Useful if downloading gated model weights or running bulk dataset transfers
HF_TOKEN=

# Copernicus Data Space Ecosystem (Free at https://dataspace.copernicus.eu)
# Useful if pulling raw ESA .SAFE archives directly from European servers
CDSE_USERNAME=
CDSE_PASSWORD=

# ISRO Bhuvan / MOSDAC Credentials (Register at https://bhuvan.nrsc.gov.in)
# Useful for sovereign Indian satellite WMS/WFS map layers
BHUVAN_API_KEY=

# NOTE: Generic cloud VLM keys (Gemini, Claude, etc.) are intentionally NOT used
# anywhere in this backend. The problem statement (SIH26167) disqualifies solutions
# built on a generic LLM/VLM without remote-sensing adaptation — see
# sih-info/selected-problem-statement-26167.md, Section 7.
