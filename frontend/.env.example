# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NOTE: A Gemini API key was previously collected here / client-side. It has been
# removed intentionally: the problem statement (SIH26167) disqualifies solutions
# built on a generic LLM/VLM without remote-sensing adaptation, and collecting a
# consumer API key client-side is also not something to demo to judges.
